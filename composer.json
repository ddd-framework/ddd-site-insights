{
    "name": "mgamadeus/ddd-site-insights",
    "description": "Search Console insights for mgamadeus/ddd: reads Google Search Console through ddd-argus, caches the answers, stores nothing and states in every answer what it covers",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-site-insights",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-site-insights/issues",
        "source": "https://github.com/ddd-framework/ddd-site-insights"
    },
    "version": "0.1.0-rc.10",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "php": ">=8.3",
        "mgamadeus/ddd": "^3.40.0",
        "mgamadeus/ddd-argus": "^1.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\SiteInsights\\": "tests/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\SiteInsights\\SiteInsightsModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "type": "library"
}
