        "/api/admin/siteInsights/sites/{siteKey}/accessChecks": {
            "post": {
                "summary": "SiteInsights Site Access Checks",
                "description": "Checks every capability of the site against the provider, live: key, token, property, permission level,\nSearch Analytics, sitemaps, URL inspection (one inspection is counted) and whether the call counters are shared.\nStates only, never a secret. A POST: each call asks the provider live and counts one URL inspection against the\nsite's daily quota, so a client must never refetch it on its own (as it would refetch a GET).",
                "parameters": [
                    {
                        "name": "siteKey",
                        "description": "Key of the site (config SiteInsights.sites)",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "type": "string",
                            "maxLength": 64
                        }
                    },
                    {
                        "name": "noCache",
                        "description": "Common request parameter — see \"Shared request parameters\".",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "outputFormat",
                        "description": "Common request parameter — see \"Shared request parameters\".",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DDD.Presentation.Api.Admin.SiteInsights.Dtos.SiteInsightsAccessChecksGetResponseDto"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "BadRequest: The data provided does not match requirements",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/DDD.Infrastructure.Exceptions.BadRequestException"
                                }
                            }
                        }
                    }
                },
                "tags": [
                    "SiteInsights"
                ]
            }
        }
    },
